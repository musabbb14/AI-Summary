# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
venv/
env/
ENV/
.venv/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Uploads, Logs, Outputs, Models (preserve directory structure via .gitkeep)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
models/*
!models/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Build & distribution
build/
dist/
*.egg-info/
